# Backend API URL (used by the API client)
# In development, the Vite proxy handles /api/* routes automatically.
# In production, set this to the full backend URL.
# Leave EMPTY in the Docker/nginx setup: nginx proxies /api/* to backend:3000,
# so the client falls back to the same-origin path '/api/v1' (client.ts).
# docker-compose already passes VITE_API_URL=/api/v1 as a build arg.
VITE_API_URL=

# Backend URL for Vite dev server proxy (optional, defaults to http://localhost:3000)
BACKEND_URL=http://localhost:3000

# Demo / mock mode (BUG-PERSIST-001)
# ONLY 'true' seeds the stores from the bundled mockData / MOCK_* datasets and
# disables all API writes. Any other value (including unset) = real API, with
# empty defaults hydrated from the backend. NEVER enable in production.
VITE_USE_MOCKS=false
