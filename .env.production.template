# =============================================================================
# IDOP / AVAN — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Usage (docker-compose reads this project's .env by default):
#
#   cp .env.production.template .env
#   # then edit .env and replace EVERY value containing REPLACE_WITH_...
#
#   docker compose config      # validate before starting
#   docker compose up -d --build
#
# Full deployment guide, verification checklist and risk notes:
#   docs/DEPLOYMENT.md
#
# RULES
#  - This file contains NO real secrets — placeholders only.
#  - Placeholders deliberately contain the marker "your-" and the backend
#    ABORTS AT STARTUP (production) if a JWT secret still contains "your-",
#    is shorter than 32 characters, or is missing — see backend/src/main.ts.
#  - Generate each secret UNIQUELY per environment. Never reuse the dev
#    values from .env / backend/.env — they are committed to this repo.
#      openssl rand -hex 32            (Linux / macOS / Git Bash)
#      python -c "import secrets;print(secrets.token_hex(32))"   (Windows)
#  - JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be DIFFERENT from each
#    other (dev already keeps them separate; keep it that way).
# =============================================================================

# ---- Database (postgres:16-alpine) ------------------------------------------
# Compose builds the backend DATABASE_URL from these three values.
POSTGRES_DB=idop
POSTGRES_USER=idop
# SECRET + unique per environment. Also becomes the password inside
# DATABASE_URL, so rotate it in ONE place (.env) only.
POSTGRES_PASSWORD=REPLACE_WITH_your_random_postgres_password
# Host port (container always listens on 5432). Change if 5433 is taken.
POSTGRES_PORT=5433

# ---- Redis (redis:7-alpine — REAL Redis, no dev shim is allowed) ----------
# Production requires a real Redis: JwtGuard blacklist checks, BullMQ and
# /api/v1/health/detailed all hit it. There is no in-process fallback.
# CAUTION (docs/DEPLOYMENT.md risk R2): leaving REDIS_PASSWORD non-empty
# enables --requirepass while the compose healthcheck runs an unauthenticated
# `redis-cli ping`, which may mark redis UNHEALTHY and block the backend.
# Verify `docker compose ps` shows redis healthy after first bring-up; if not,
# see the R2 workarounds in docs/DEPLOYMENT.md before proceeding.
REDIS_PORT=6379
# SECRET + unique per environment. Set empty (REDIS_PASSWORD=) only if you
# accept an unauthenticated Redis bound to a private network.
REDIS_PASSWORD=REPLACE_WITH_your_random_redis_password

# ---- MQTT (eclipse-mosquitto:2.0) ------------------------------------------
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ---- MinIO (object storage) ------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
# SECRET + unique — the image defaults to minioadmin/minioadmin. Change them.
MINIO_ACCESS_KEY=REPLACE_WITH_your_minio_user
MINIO_SECRET_KEY=REPLACE_WITH_your_random_minio_password

# ---- JWT (REQUIRED — backend refuses to start in production otherwise) -----
# Generate each UNIQUELY:  openssl rand -hex 32
# Must be >= 32 chars, must NOT contain "your-" (leftover placeholders are
# fatal by design), and the two values must be DIFFERENT from each other
# and different from every dev/staging secret.
JWT_ACCESS_SECRET=REPLACE_WITH_your_random_jwt_access_secret_hex32
JWT_REFRESH_SECRET=REPLACE_WITH_your_random_jwt_refresh_secret_hex32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Ports published by docker-compose -------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=80

# ---- SMS provider (REQUIRED for boot in production) ------------------------
# main.ts fails fast unless KAVENEGAR_API_KEY OR MELIPAYAMAK_USERNAME is set.
# A placeholder satisfies boot; a real key is needed only to actually send OTP.
# SECRET + unique per environment.
KAVENEGAR_API_KEY=REPLACE_WITH_your_kavenegar_api_key
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

# ---- Email (SMTP, optional — no fail-fast) ---------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
# SECRET
SMTP_PASS=REPLACE_WITH_your_smtp_password

# ---- B2B bid encryption (REQUIRED — used at runtime by BidService) ---------
# SECRET + unique per environment:  openssl rand -hex 32
# Changing it later invalidates previously encrypted bid payloads.
BID_ENCRYPTION_SECRET=REPLACE_WITH_your_random_bid_secret_hex32

# ---- Super-admin system-config encryption (REQUIRED for boot) --------------
# system-config.service.ts throws at import time in production if unset.
# SECRET + unique per environment:  openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_your_random_config_key_hex32

# ---- CORS ------------------------------------------------------------------
# Read by backend/src/main.ts ONLY. NOTE: docker-compose.yml currently sets
# CORS_ORIGINS as a hardcoded literal, so this value has NO effect on the
# dockerized backend (same-origin nginx proxying makes it unnecessary for the
# SPA). Listed for completeness/native runs:
CORS_ORIGINS=https://your-domain.example

# ---- Frontend build-time settings ------------------------------------------
# MUST be false (or unset) in production — only the literal string "true"
# enables mock/demo data and disables API writes (Frontend/src/shared/lib/mockMode.ts).
# The dockerized frontend build does not pass this through at all (= off).
VITE_USE_MOCKS=false
# API base baked into the SPA by the frontend image build arg. Keep /api/v1
# for the nginx same-origin proxy setup.
VITE_API_URL=/api/v1
# Vite dev-server proxy target (native dev only; ignored by docker-compose).
BACKEND_URL=http://localhost:3000

# ---- Native-dev backend settings (NOT read by docker-compose) --------------
# docker-compose derives DATABASE_URL/REDIS_HOST itself; these are for running
# `node dist/main.js` directly against local services (see README quickstart).
DATABASE_URL=postgresql://REPLACE_WITH_your_random_postgres_password@localhost:5433/idop?schema=public
REDIS_HOST=localhost
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=idop-backend
NODE_ENV=production

# ---- Post-deploy seeding (backend/scripts/seed-admins.js) ------------------
# SECRET + unique — NEVER leave the script's default (Avan@1404) in production.
ADMIN_PASSWORD=REPLACE_WITH_your_random_admin_password
