# IDOP Production Environment Configuration
# Copy this file to .env and fill in the values

# ---- Database ----
POSTGRES_DB=idop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5433

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- MQTT ----
MQTT_PORT=1883
MQTT_WS_PORT=9001

# ---- MinIO ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD

# ---- JWT (REQUIRED - at least 32 characters each) ----
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Backend ----
BACKEND_PORT=3000
NODE_ENV=production

# ---- Frontend ----
FRONTEND_PORT=80

# Comma-separated CORS whitelist for the backend (main.ts splits on ',').
# Keep the frontend origin FIRST. credentials:true is enabled, so every origin
# listed here is trusted with cookies (the HttpOnly refresh cookie).
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ---- SMS Provider (KaveNegar or MeliPayamak) ----
# NOTE: with NODE_ENV=production the backend REFUSES TO START unless at least
# one of these is configured (main.ts fail-fast). Set KAVENEGAR_API_KEY or
# MELIPAYAMAK_USERNAME even for a non-SMS deployment, or run with
# NODE_ENV=development during local bring-up.
KAVENEGAR_API_KEY=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- B2B Encryption ----
BID_ENCRYPTION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
