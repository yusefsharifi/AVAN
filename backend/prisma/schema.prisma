// ═══════════════════════════════════════════════════════════════════════════════
// MODELS — M8: Workflow Engine
// ═══════════════════════════════════════════════════════════════════════════════

model WorkflowDefinition {
  id                   String           @id @default(uuid())
  zoneId               String?
  code                 String           @unique
  nameFa               String
  descriptionFa        String?
  category             WorkflowCategory
  version              Int              @default(1)
  isActive             Boolean          @default(true)
  isSystem             Boolean          @default(false)
  definition           Json
  defaultSlaHours      Int              @default(72)
  allowReassign        Boolean          @default(true)
  allowDelegate        Boolean          @default(true)
  requireComment       Boolean          @default(false)
  notifyOnEachStep     Boolean          @default(true)
  autoArchiveAfterDays Int              @default(90)
  usageCount           Int              @default(0)
  lastUsedAt           DateTime?
  createdBy            String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  zone      Zone?                       @relation(fields: [zoneId], references: [id])
  instances WorkflowInstance[]
  versions  WorkflowDefinitionVersion[]

  @@index([zoneId, category, isActive])
  @@index([code])
}

model WorkflowDefinitionVersion {
  id           String   @id @default(uuid())
  definitionId String
  version      Int
  definition   Json
  changedBy    String
  changeNote   String?
  createdAt    DateTime @default(now())

  workflowDef WorkflowDefinition @relation(fields: [definitionId], references: [id])

  @@unique([definitionId, version])
}

model WorkflowInstance {
  id                String           @id @default(uuid())
  zoneId            String
  definitionId      String
  definitionCode    String
  definitionVersion Int
  entityType        String
  entityId          String
  status            InstanceStatus   @default(RUNNING)
  currentStepIds    String[]
  completedStepIds  String[]
  skippedStepIds    String[]
  variables         Json             @default("{}")
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  terminatedAt      DateTime?
  pausedAt          DateTime?
  resumedAt         DateTime?
  slaDeadline       DateTime?
  outcome           InstanceOutcome?
  outcomeReason     String?
  triggeredBy       String?
  notes             String?
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  zone        Zone                 @relation(fields: [zoneId], references: [id])
  definition  WorkflowDefinition   @relation(fields: [definitionId], references: [id])
  tasks       WorkflowTask[]
  events      WorkflowEvent[]
  escalations WorkflowEscalation[]

  @@index([zoneId, status])
  @@index([entityType, entityId])
  @@index([definitionCode, status])
  @@index([zoneId, createdAt])
}

model WorkflowTask {
  id                 String        @id @default(uuid())
  instanceId         String
  zoneId             String
  stepId             String
  stepName           String
  stepNameFa         String
  assigneeId         String?
  assigneeRole       String?
  assigneeGroupId    String?
  type               TaskType
  status             TaskStatus    @default(PENDING)
  formSchema         Json?
  formData           Json?
  decision           TaskDecision?
  comment            String?
  attachments        String[]
  actionType         String?
  actionConfig       Json?
  actionResult       Json?
  slaDueAt           DateTime?
  slaHours           Int?
  slaBreached        Boolean       @default(false)
  slaBreachNotified  Boolean       @default(false)
  originalAssigneeId String?
  delegatedTo        String?
  delegatedAt        DateTime?
  delegationReason   String?
  activatedAt        DateTime?
  claimedAt          DateTime?
  completedAt        DateTime?
  skippedAt          DateTime?
  priority           TaskPriority  @default(NORMAL)
  reminder24hSent    Boolean       @default(false)
  reminder2hSent     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])

  @@index([assigneeId, status])
  @@index([assigneeRole, zoneId, status])
  @@index([instanceId, status])
  @@index([slaDueAt, slaBreached])
  @@index([zoneId, status, priority])
}

model WorkflowEvent {
  id          String            @id @default(uuid())
  instanceId  String
  zoneId      String
  stepId      String?
  taskId      String?
  type        WorkflowEventType
  actorId     String?
  actorName   String?
  description String
  payload     Json              @default("{}")
  occurredAt  DateTime          @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])

  @@index([instanceId, occurredAt])
  @@index([zoneId, occurredAt])
  @@index([type, occurredAt])
}

model WorkflowEscalation {
  id          String           @id @default(uuid())
  instanceId  String
  taskId      String?
  zoneId      String
  level       Int              @default(1)
  reason      EscalationReason
  escalatedTo String
  message     String
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime         @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id])

  @@index([instanceId])
  @@index([zoneId, createdAt])
}

model WorkflowSlaConfig {
  id                 String   @id @default(uuid())
  zoneId             String?
  definitionCode     String
  stepId             String
  slaHours           Int
  warningAtPercent   Int      @default(75)
  escalationLevel1   String?
  escalationLevel2   String?
  escalationLevel3   String?
  escalateAfterHours Int      @default(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  zone Zone? @relation(fields: [zoneId], references: [id])

  @@unique([definitionCode, stepId, zoneId])
}

model TaskInboxEntry {
  id          String       @id @default(uuid())
  userId      String
  zoneId      String
  taskId      String       @unique
  instanceId  String
  entityType  String
  entityId    String
  title       String
  description String?
  priority    TaskPriority
  slaDueAt    DateTime?
  isRead      Boolean      @default(false)
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([userId, zoneId, isRead])
  @@index([userId, priority])
  @@index([userId, slaDueAt])
}

model WorkflowGroup {
  id        String   @id @default(uuid())
  zoneId    String
  code      String
  nameFa    String
  members   String[]
  roles     String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, code])
}

model WorkflowMetricSnapshot {
  id                String   @id @default(uuid())
  zoneId            String
  definitionCode    String
  period            String
  periodType        String
  totalStarted      Int      @default(0)
  totalCompleted    Int      @default(0)
  totalTerminated   Int      @default(0)
  avgDurationHours  Decimal  @db.Decimal(10, 2)
  slaBreachCount    Int      @default(0)
  slaComplianceRate Decimal  @db.Decimal(5, 2)
  computedAt        DateTime @default(now())

  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, definitionCode, period, periodType])
  @@index([zoneId, periodType, period])
}

