model AccountCode {
  id            String          @id @default(uuid())
  zoneId        String?
  code          String
  nameFa        String
  nameEn        String?
  type          AccountType
  category      AccountCategory
  parentId      String?
  level         Int             @default(1)
  isActive      Boolean         @default(true)
  isSystem      Boolean         @default(false)
  normalBalance BalanceType
  description   String?
  createdBy     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  parent      AccountCode?  @relation("AccountParent", fields: [parentId], references: [id])
  children    AccountCode[] @relation("AccountParent")
  debitLines  VoucherLine[] @relation("DebitAccount")
  creditLines VoucherLine[] @relation("CreditAccount")
  budgetLines BudgetLine[]

  @@unique([zoneId, code])
  @@index([zoneId, type, isActive])
  @@index([parentId])
}

model CostCenter {
  id        String   @id @default(uuid())
  zoneId    String
  code      String
  nameFa    String
  type      String
  isActive  Boolean  @default(true)
  managerId String?
  budget    BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, code])
}

model AccountingVoucher {
  id               String        @id @default(uuid())
  zoneId           String
  voucherNumber    String        @unique
  type             VoucherType
  date             String
  gregorianDate    DateTime
  description      String
  reference        String?
  status           VoucherStatus @default(DRAFT)
  sourceModule     String?
  sourceEntityId   String?
  sourceEntityType String?
  totalDebit       BigInt        @default(0)
  totalCredit      BigInt        @default(0)
  preparedBy       String
  preparedByName   String
  reviewedBy       String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  currencyCode     String        @default("IRR")
  exchangeRate     Decimal       @default(1) @db.Decimal(15, 4)
  attachmentKeys   String[]
  notes            String?
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  zone  Zone          @relation(fields: [zoneId], references: [id])
  lines VoucherLine[]

  @@index([zoneId, status])
  @@index([zoneId, type])
  @@index([zoneId, gregorianDate])
  @@index([sourceModule, sourceEntityId])
  @@index([voucherNumber])
}

model VoucherLine {
  id              String   @id @default(uuid())
  voucherId       String
  lineNumber      Int
  description     String
  debitAccountId  String?
  creditAccountId String?
  debitAmount     BigInt   @default(0)
  creditAmount    BigInt   @default(0)
  costCenterId    String?
  partyId         String?
  partyName       String?
  taxRate         Decimal? @db.Decimal(5, 2)
  taxAmount       BigInt?
  reference       String?
  metadata        Json     @default("{}")

  voucher       AccountingVoucher @relation(fields: [voucherId], references: [id])
  debitAccount  AccountCode?      @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount AccountCode?      @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([voucherId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

model Invoice {
  id              String           @id @default(uuid())
  zoneId          String
  companyId       String?
  invoiceNumber   String           @unique
  type            InvoiceType
  direction       InvoiceDirection
  status          InvoiceStatus    @default(DRAFT)
  partyId         String?
  partyName       String
  partyCode       String?
  partyNationalId String?
  partyAddress    String?
  partyPhone      String?
  issueDate       String
  dueDate         String?
  paidDate        String?
  sourceModule    String?
  sourceEntityId  String?
  subtotal        BigInt
  totalDiscount   BigInt           @default(0)
  totalTax        BigInt
  grandTotal      BigInt
  paidAmount      BigInt           @default(0)
  remainingAmount BigInt
  currencyCode    String           @default("IRR")
  exchangeRate    Decimal          @default(1) @db.Decimal(15, 4)
  paymentTerms    String?
  paymentMethod   String?
  voucherId       String?
  pdfKey          String?
  notes           String?
  metadata        Json             @default("{}")
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

