model BudgetLine {
  id            String  @id @default(uuid())
  budgetId      String
  accountCodeId String
  costCenterId  String?
  amount        BigInt
  q1Amount      BigInt  @default(0)
  q2Amount      BigInt  @default(0)
  q3Amount      BigInt  @default(0)
  q4Amount      BigInt  @default(0)
  actualAmount  BigInt  @default(0)
  description   String?

  budget  Budget      @relation(fields: [budgetId], references: [id])
  account AccountCode @relation(fields: [accountCodeId], references: [id])

  @@index([budgetId])
  @@index([accountCodeId])
}

model FinancialPeriod {
  id        String       @id @default(uuid())
