model ProductionLine {
  id                  String               @id @default(uuid())
  zoneId              String?
  code                String
  nameFa              String
  capacity            Float
  currentStatus       ProductionLineStatus @default(idle)
  currentWorkOrderId  String?
  shift               ProductionLineShift  @default(morning)
  oee                 Float                @default(0)
  lastMaintenanceDate String?
  nextMaintenanceDate String?
  supervisorName      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([zoneId])
  @@index([code])
  @@index([currentStatus])
}

model ProductionSalesOrder {
  id           String                     @id @default(uuid())
  orderNumber  String                     @unique
  customerId   String
  customerName String
  orderDate    String
  requiredDate String
  status       ProductionSalesOrderStatus @default(draft)
  priority     ProductionOrderPriority    @default(normal)
  lines        Json                       @default("[]")
  totalValue   Float                      @default(0)
  notes        String?
  confirmedAt  String?
  completedAt  String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([status])
  @@index([customerId])
}

model ProductionWorkOrder {
  id                     String                   @id @default(uuid())
  workOrderNumber        String                   @unique
  salesOrderId           String?
  salesOrderNumber       String?
  itemId                 String?
  itemNameFa             String?
  itemSku                String?
  plannedQuantity        Float
  actualQuantity         Float                    @default(0)
  scrapQuantity          Float                    @default(0)
  uom                    String
  lineId                 String?
  lineName               String?
  scheduledStart         String?
  scheduledEnd           String?
  actualStart            String?
  actualEnd              String?
  status                 ProductionWorkOrderStatus @default(planned)
  priority               ProductionOrderPriority  @default(normal)
  assignedShift          ProductionShift?
  supervisorId           String?
  supervisorName         String?
  bomId                  String?
  estimatedDurationHours Float?
  actualDurationHours    Float?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status])
  @@index([lineId])
  @@index([salesOrderId])
}

model ProductionBom {
  id                 String              @id @default(uuid())
  bomNumber          String              @unique
  finishedItemId     String?
  finishedItemNameFa String?
  finishedItemSku    String?
  version            String              @default("v1.0")
  status             ProductionBomStatus @default(draft)
  outputQuantity     Float               @default(1)
  outputUom          String              @default("piece")
  lines              Json                @default("[]")
  totalMaterialCost  Float               @default(0)
  processingCost     Float               @default(0)
  totalCost          Float               @default(0)
  effectiveFrom      String?
  approvedBy         String?
  approvedAt         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([finishedItemId])
}

model QualityCheck {
  id              String                @id @default(uuid())
  checkNumber     String                @unique
  workOrderId     String?
  workOrderNumber String?
  itemId          String?
  itemNameFa      String?
  checkType       ProductionCheckType   @default(in_process)
  sampleSize      Int                   @default(0)
  defectCount     Int                   @default(0)
  defectRate      Float                 @default(0)
  result          ProductionCheckResult @default(pending)
  checkedBy       String?
  checkedAt       String?
  parameters      Json                  @default("[]")
  notes           String?
  attachments     Json                  @default("[]")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([workOrderId])
  @@index([result])
}

model NonConformanceReport {
  id               String          @id @default(uuid())
  ncrNumber        String          @unique
  workOrderId      String?
  grnId            String?
  title            String
  description      String?
  severity         NcrSeverity     @default(minor)
  status           NcrStatus       @default(open)
  raisedBy         String?
  raisedAt         String?
  assignedTo       String?
  rootCause        String?
  correctiveAction String?
  closedAt         String?
  closedBy         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([workOrderId])
}

model ScrapRecord {
  id             String              @id @default(uuid())
  workOrderId    String?
  itemId         String?
  itemNameFa     String?
  quantity       Float
  uom            String?
  reason         ScrapReason         @default(other)
  cost           Float               @default(0)
  recordedBy     String?
  recordedAt     String?
  disposalMethod ScrapDisposalMethod?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([workOrderId])
}

// ============================================================================
// M-ERP: Finance ERP extensions (Step 6 / TASK C — R5)
//
// These back the three endpoint groups the frontend already calls but the
// backend never exposed: /finance/fixed-assets, /finance/documents and
// /finance/buyer-sellers (see the TODO(BACKEND) notes in
// Frontend/src/modules/finance/api/finance.api.ts).
//
// Enum VALUES deliberately match the frontend wire contract exactly (lowercase),
// so no mapping layer is needed. They are prefixed `Finance...` because the
// schema already has unrelated AssetCategory / AssetStatus / PaymentMethod
// enums with different, UPPERCASE value sets used by other modules.
//
// Monetary columns are BigInt (the platform-wide convention; main.ts installs a
// json replacer that emits them as Number). Rates and ratios stay Float.
// ============================================================================

enum FinanceAssetCategory {
  land
  building
  machinery
  vehicle
  furniture
  it_equipment
}

enum FinanceDepreciationMethod {
  straight_line
  declining_balance
  units_of_production
}

enum FinanceAssetStatus {
  active
  under_maintenance
  idle
  disposed
  sold
  deleted
}

enum FinanceDisposalType {
  sale
  scrap
  donation
}

enum FinanceMaintenanceType {
  preventive
  corrective
  emergency
}

enum FinanceDocumentStatus {
  draft
  prepared
  approved
  authorized
  posted
  cancelled
}

enum FinancePurchaseDocType {
  purchase_invoice
  purchase_return
  pre_invoice_purchase
}

enum FinanceSalesDocType {
  sales_invoice
  sales_return
  pre_invoice_sales
}

enum FinanceCurrencyCode {
  IRR
  USD
  EUR
}

enum FinanceBuyerSellerType {
  buyer
  seller
  both
}

enum FinancePaymentMethod {
  cash
  check
  credit
  online
  lc
  bank_transfer
}

enum FinanceBuyerSellerStatus {
  active
  inactive
  blacklisted
}

model FixedAsset {
  id            String                    @id @default(uuid())
  zoneId        String
  companyId     String?
  assetCode     String
  name          String
  category      FinanceAssetCategory
  location      String?

  acquisitionDate      DateTime
  acquisitionCost      BigInt  @default(0)
  additionalCosts      BigInt  @default(0)
  totalCapitalizedCost BigInt  @default(0)

  depreciationMethod   FinanceDepreciationMethod @default(straight_line)
  usefulLifeYears      Int     @default(1)
  salvageValue         BigInt  @default(0)
  depreciationStartDate DateTime
  accumulatedDepreciation BigInt @default(0)
  netBookValue         BigInt  @default(0)

  status           FinanceAssetStatus  @default(active)
  disposalDate     DateTime?
  disposalType     FinanceDisposalType?
  disposalBuyer    String?
  disposalNotes    String?
  disposalProceeds BigInt?
  gainLossOnDisposal BigInt?

  insurancePolicyId      String?
  depreciationVoucherIds String[] @default([])
  qrCode                 String?
  attachmentName         String?

  // GL links used by depreciation and disposal postings.
  assetAccountId      String?
  depExpenseAccountId String?
  accumDepAccountId   String?

  // Cross-module link set by HR's Asset Custody actions.
  custodianEmployeeId String?
  custodianName       String?
  assignedAt          DateTime?

  maintenanceRecords MaintenanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, assetCode])
  @@index([zoneId, status])
  @@index([zoneId, category])
}

model MaintenanceRecord {
  id        String                @id @default(uuid())
  assetId   String
  date      DateTime
  type      FinanceMaintenanceType
  description String
  cost      BigInt    @default(0)
  vendor    String?
  nextMaintenanceDate DateTime?

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model FinanceDocument {
  id             String                  @id @default(uuid())
  zoneId         String
  companyId      String?
  documentNumber String
  kind           String // 'purchase' | 'sales' — the single table serves both
  date           DateTime
  status         FinanceDocumentStatus   @default(draft)
  statusChangeDate DateTime

  // Purchase side
  purchaseType FinancePurchaseDocType?
  vendorName   String?
  vendorCode   String?
  payableAmount BigInt?

  // Sales side
  salesType   FinanceSalesDocType?
  buyerName   String?
  buyerCode   String?
  receivableAmount BigInt?

  itemNumber       String?
  lineCount        Int      @default(0)
  notes            String   @default("")
  preparedBy       String   @default("")
  approvedBy       String   @default("")
  authorizedBy     String   @default("")
  accountingDocRef String?
  escrowRequired   Boolean  @default(false)
  visitorName      String   @default("")

  projectId    String?
  costCenterId String?
  currencyCode FinanceCurrencyCode @default(IRR)
  exchangeRate Float               @default(1)

  totalBeforeDiscount BigInt @default(0)
  totalDiscount       BigInt @default(0)
  totalTax            BigInt @default(0)
  grandTotal          BigInt @default(0)

  lines DocumentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, kind, documentNumber])
  @@index([zoneId, kind])
  @@index([zoneId, status])
}

model DocumentLine {
  id         String  @id @default(uuid())
  documentId String
  itemCode   String
  itemName   String
  quantity   Int     @default(1)
  unitPrice  BigInt  @default(0)
  discount   BigInt  @default(0)
  taxRate    Float   @default(0)
  lineTotal  BigInt  @default(0)
  warehouseId String?
  projectId  String?
  costCenterId String?
  notes      String  @default("")

  document FinanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
}

model BuyerSeller {
  id       String                @id @default(uuid())
  zoneId   String
  companyId String?
  code     String
  name     String
  title    String   @default("")
  type     FinanceBuyerSellerType
  paymentMethod FinancePaymentMethod @default(cash)

  groupName String @default("")
  groupId   String?
  notes     String @default("")
  visitorId String?

  subAccountId             String?
  transferredFromAccounting Boolean @default(false)

  taxId   String  @default("")
  address String  @default("")
  phone   String  @default("")

  creditLimit    BigInt @default(0)
  currentBalance BigInt @default(0)

  status FinanceBuyerSellerStatus @default(active)

  bankAccounts BuyerSellerBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, code])
  @@index([zoneId, status])
  @@index([zoneId, type])
}

model BuyerSellerBankAccount {
  id            String  @id @default(uuid())
  buyerSellerId String
  bankName      String
  accountNumber String
  iban          String  @default("")

  buyerSeller BuyerSeller @relation(fields: [buyerSellerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerSellerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Step 7 TASK A — the four endpoint groups left with TODO(BACKEND) markers.
//
// NOTE ON `Visitor`: the schema already had `VisitorRequest` / `VisitorTracking`
// / `VisitorAttachment` / `VisitorBlacklist`, but those are the GUARD PORTAL's
// site-access domain (QR payload, allowed gates, check-in/out, escort flags).
// The finance `Visitor` is a commission-earning field sales agent
// (`commissionRate`, `region`, active/inactive) that `BuyerSeller.visitorId`
// points at. They only share a word. Reusing or extending `VisitorRequest` would
// have forced 40 unrelated columns onto a sales agent, so this is a separate
// `FinanceVisitor` — recorded as a mapping decision in docs/STEP7-REPORT.md.
// ═══════════════════════════════════════════════════════════════════════════

enum FinanceVisitorStatus {
  active
  inactive
}

model FinanceVisitor {
  id             String  @id @default(uuid())
  zoneId         String
  code           String
  name           String
  phone          String  @default("")
  region         String  @default("")
  commissionRate Float   @default(0)
  status         FinanceVisitorStatus @default(active)
  notes          String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, code])
  @@index([zoneId, status])
}

enum FinanceCheckbookStatus {
  active
  exhausted
  cancelled
}

model FinanceCheckbook {
  id            String  @id @default(uuid())
  zoneId        String
  bookNumber    String
  // Opaque references: the store seeds checkbooks and bank accounts from local
  // mocks that never exist server-side, so a relational FK here would turn a
  // perfectly normal UI flow into a Prisma P2003 500. Stored as strings.
  bankAccountId String  @default("")
  bankName      String  @default("")
  accountNumber String  @default("")

  series        String  @default("")
  startNumber   String  @default("")
  endNumber     String  @default("")
  currentNumber String  @default("")

  totalLeaves    Int @default(0)
  usedLeaves     Int @default(0)
  remainingLeaves Int @default(0)

  status     FinanceCheckbookStatus @default(active)
  issuedDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, bookNumber])
  @@index([zoneId, status])
}

enum FinanceCheckDirection {
  incoming
  outgoing
}

enum FinanceCheckStatus {
  issued
  pending_clearance
  cleared
  bounced
  cancelled
  returned
}

model FinanceCheck {
  id         String @id @default(uuid())
  zoneId     String
  checkNumber String
  // Opaque, see the note on FinanceCheckbook.
  checkbookId  String @default("")
  bankAccountId String @default("")
  bankName     String @default("")

  direction FinanceCheckDirection
  payeeName String  @default("")
  payerName String  @default("")

  amount   BigInt @default(0)
  currency FinanceCurrencyCode @default(IRR)

  issueDate    DateTime
  dueDate      DateTime
  clearanceDate DateTime?

  status FinanceCheckStatus @default(issued)

  // References to records this module does not own or does not validate:
  // `rpDocumentId` points at a receipt/payment doc and `glVoucherId` at a
  // journal voucher. Both are kept as plain strings on purpose — a bidirectional
  // FK (doc.checkId <-> check.rpDocumentId) would create a delete cycle, and
  // neither reference is required for the record to be valid.
  rpDocumentId String?
  glVoucherId  String?

  bounceReason        String?
  bounceDate          DateTime?
  bouncePenaltyAmount BigInt?

  notes     String @default("")
  createdBy String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, checkNumber])
  @@index([zoneId, status])
  @@index([zoneId, checkbookId])
}

enum FinanceRpDocType {
  cash_receipt
  check_receipt
  transfer_receipt
  cash_payment
  check_payment
  transfer_payment
}

enum FinanceRpType {
  receipt
  payment
  internal_transfer
}

enum FinanceRpStatus {
  draft
  prepared
  approved
  posted
  bounced
  cancelled
}

enum FinanceInstrumentType {
  cash
  check
  promissory_note
  bank_transfer
  online
  lc
}

enum FinanceEntityType {
  buyer
  seller
  employee
  other
}

model FinanceReceiptPaymentDoc {
  id             String  @id @default(uuid())
  zoneId         String
  documentNumber String
  docType        FinanceRpDocType
  date           DateTime
  type           FinanceRpType
  status         FinanceRpStatus @default(draft)
  statusChangeDate DateTime

  entityId     String  @default("")
  entityName   String  @default("")
  entityType   FinanceEntityType @default(other)

  instrumentType FinanceInstrumentType @default(cash)
  checkId        String?
  checkNumber    String?
  checkDate      DateTime?
  bankName       String?
  bankBranch     String?
  bankAccountId  String?
  transactionRef String?

  totalAmount  BigInt @default(0)
  currency     FinanceCurrencyCode @default(IRR)
  exchangeRate Float  @default(1)

  parentDocumentId String?
  parentDocNumber  String?
  isPartial        Boolean @default(false)
  remainingAmount  BigInt?

  preparedBy String  @default("")
  approvedBy String?
  postedBy   String?

  notes       String @default("")
  description String @default("")

  glVoucherId   String?
  cancelReason  String?
  bounceReason  String?

  lines FinanceReceiptPaymentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId, documentNumber])
  @@index([zoneId, status])
  @@index([zoneId, docType])
}

model FinanceReceiptPaymentLine {
  id          String @id @default(uuid())
  docId       String
  accountId   String  @default("")
  // Denormalised snapshot of the chart-of-accounts entry: kept as posted so the
  // document still reads correctly if the account is later renamed, which is
  // why it is stored rather than re-joined on every read.
  accountCode String  @default("")
  accountName String  @default("")
  amount      BigInt  @default(0)
  description String  @default("")
  projectId   String?
  costCenterId String?

  doc FinanceReceiptPaymentDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([docId])
}
