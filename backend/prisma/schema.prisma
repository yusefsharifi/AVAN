// MODELS — M7: Correspondence & Document Automation
// ═══════════════════════════════════════════════════════════════════════════════

model Letter {
  id             String  @id @default(uuid())
  zoneId         String
  companyId      String?
  registryNumber String  @unique
  registryYear   Int
  registrySeq    Int

  direction      LetterDirection
  type           LetterType
  classification LetterClassification @default(UNCLASSIFIED)
  priority       LetterPriority       @default(NORMAL)
  topic          String?

  subject         String
  body            String  @db.Text
  salutation      String?
  closing         String?
  enclosuresCount Int     @default(0)

  senderId              String?
  senderName            String
  senderOrgName         String
  senderRole            String?
  recipients            Json
  cc                    Json    @default("[]")
  referenceLetterNumber String?
  referenceLetterId     String?

  status           LetterStatus @default(DRAFT)
  rejectionReason  String?
  currentStepIndex Int          @default(0)
  signatory        String?
  signatoryRole    String?
  signatoryId      String?

  slaHours         Int       @default(72)
  slaDeadline      DateTime?
  slaBreached      Boolean   @default(false)
  responseDeadline DateTime?

  qrHash       String  @unique
  qrImageKey   String?
  verifyUrl    String?
  hashChain    String?
  previousHash String?

  dispatchRecord  Json?
  archiveLocation Json?

  currentVersion  Int     @default(1)
  isLatestVersion Boolean @default(true)
  parentLetterId  String?

  isAutoGenerated Boolean @default(false)
  sourceModule    String?
  sourceEntityId  String?
  sourceEventType String?

  templateId String?

  relatedLetterIds String[]
  starred          Boolean  @default(false)
  unread           Boolean  @default(true)
  tags             String[]

  internalNotes String?
  metadata      Json      @default("{}")
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sentAt        DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?

  zone            Zone                   @relation(fields: [zoneId], references: [id])
  company         Company?               @relation(fields: [companyId], references: [id])
  approvalSteps   LetterApprovalStep[]
  versions        LetterVersion[]
  attachments     LetterAttachment[]
  annotations     LetterAnnotation[]
  auditTrail      LetterAuditEntry[]
  physicalRecords PhysicalLetterRecord[]

  @@index([zoneId, status])
  @@index([zoneId, direction, status])
  @@index([companyId, status])
  @@index([zoneId, registryYear, registrySeq])
  @@index([qrHash])
  @@index([registryNumber])
  @@index([sourceModule, sourceEntityId])
  @@index([zoneId, createdAt])
  @@index([zoneId, topic])
}

model LetterApprovalStep {
  id           String         @id @default(uuid())
  letterId     String
  stepOrder    Int
  roleFa       String
  assigneeId   String?
  assigneeName String?
  type         StepType
  isRequired   Boolean        @default(true)
  status       ApprovalStatus @default(PENDING)
  dueAt        DateTime?
  completedAt  DateTime?
  comment      String?
  signatureRef String?
  signatureKey String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  letter Letter @relation(fields: [letterId], references: [id])

  @@unique([letterId, stepOrder])
  @@index([assigneeId, status])
  @@index([letterId, status])
}

model LetterVersion {
  id            String   @id @default(uuid())
  letterId      String
  versionNumber Int
  subject       String
  body          String   @db.Text
  changeNote    String
  createdBy     String
  createdAt     DateTime @default(now())
  snapshot      Json

  letter Letter @relation(fields: [letterId], references: [id])

  @@unique([letterId, versionNumber])
}

model LetterAttachment {
  id         String   @id @default(uuid())
  letterId   String
  type       String
  title      String
  fileKey    String
  fileName   String
  fileSize   Int
  mimeType   String
  sortOrder  Int      @default(0)
  uploadedBy String
  uploadedAt DateTime @default(now())

  letter Letter @relation(fields: [letterId], references: [id])

  @@index([letterId])
}

model LetterAnnotation {
  id         String   @id @default(uuid())
  letterId   String
  authorId   String
  authorName String
  content    String
  color      String   @default("YELLOW")
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  letter Letter @relation(fields: [letterId], references: [id])

  @@index([letterId])
}

model LetterAuditEntry {
  id           String   @id @default(uuid())
  letterId     String
  zoneId       String
  action       String
  actorId      String?
  actorName    String?
  actorRole    String?
  description  String
  metadata     Json     @default("{}")
  ipAddress    String?
  hash         String
  previousHash String?
  timestamp    DateTime @default(now())

  letter Letter @relation(fields: [letterId], references: [id])

  @@index([letterId, timestamp])
  @@index([zoneId, timestamp])
}

model LetterTemplate {
  id                    String               @id @default(uuid())
  zoneId                String?
  code                  String               @unique
  nameFa                String
  descriptionFa         String?
  category              TemplateCategory
  direction             LetterDirection
  type                  LetterType
  classification        LetterClassification @default(UNCLASSIFIED)
  priority              LetterPriority       @default(NORMAL)
  subjectTemplate       String
  bodyTemplate          String               @db.Text
  salutationTemplate    String?
  closingTemplate       String?
  variables             Json
  defaultSlaHours       Int                  @default(72)
  approvalChainTemplate Json
  autoTrigger           Json?
  tags                  String[]
  isActive              Boolean              @default(true)
  usageCount            Int                  @default(0)
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([code])
  @@index([type, isActive])
}

model PhysicalArchiveShelf {
  id        String   @id @default(uuid())
  zoneId    String
  shelfCode String
  nameFa    String
  capacity  Int      @default(50)
  occupancy Int      @default(0)
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone    Zone                   @relation(fields: [zoneId], references: [id])
  letters PhysicalLetterRecord[]

  @@unique([zoneId, shelfCode])
  @@index([zoneId, isActive])
}

model PhysicalLetterRecord {
  id           String    @id @default(uuid())
  zoneId       String
  letterId     String
  shelfId      String
  barcode      String    @unique
  receivedAt   DateTime  @default(now())
  receivedBy   String
  movedAt      DateTime?
  movedBy      String?
  movedReason  String?
  dispatchedAt DateTime?
  dispatchedBy String?
  notes        String?

  zone   Zone                 @relation(fields: [zoneId], references: [id])
  letter Letter               @relation(fields: [letterId], references: [id])
  shelf  PhysicalArchiveShelf @relation(fields: [shelfId], references: [id])

  @@index([zoneId, receivedAt])
  @@index([letterId])
  @@index([barcode])
}

model RegistryCounter {
  id      String @id @default(uuid())
  zoneId  String
  year    Int
  counter Int    @default(0)

  @@unique([zoneId, year])
}

