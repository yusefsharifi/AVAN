// ============================================================================
// IDOP Prisma Schema — Modules M1, M2, M3
// Industrial Digital Operations Platform
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — M1: Auth & User Management
// ═══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  SUPER_ADMIN
  ZONE_MANAGER
  ZONE_OPERATOR
  COMPANY_ADMIN
  COMPANY_MANAGER
  COMPANY_STAFF
  GUARD
  DRIVER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  LOCKED
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
  DOCUMENT_SIGN
}

enum RoleScope {
  GLOBAL
  ZONE
  COMPANY
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — M2: Zone & Company Onboarding
// ═══════════════════════════════════════════════════════════════════════════════

enum ZoneStatus {
  ACTIVE
  MAINTENANCE
  SUSPENDED
  CLOSED
}

enum GateType {
  MAIN_ENTRY
  MAIN_EXIT
  COMBINED
  EMERGENCY
  TRUCK_ONLY
  STAFF_ONLY
}

enum HolidayType {
  NATIONAL
  RELIGIOUS
  ZONE_SPECIFIC
}

enum CompanyType {
  MANUFACTURING
  SERVICE
  TRADING
  LOGISTICS
  STORAGE
  MIXED
}

enum CompanyLifecycle {
  APPLICANT
  UNDER_REVIEW
  FINANCE_REVIEW
  HSE_REVIEW
  PLOT_ALLOCATION
  ZONE_MANAGER_APPROVAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum PlotType {
  INDUSTRIAL
  COMMERCIAL
  STORAGE
  OFFICE
  MIXED
  GREEN_SPACE
  INFRASTRUCTURE
}

enum PlotStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OnboardingStepName {
  INITIAL_REVIEW
  FINANCIAL_REVIEW
  HSE_REVIEW
  PLOT_ALLOCATION
  MANAGER_APPROVAL
  CONTRACT_SIGNING
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum DocumentType {
  ARTICLES_OF_ASSOCIATION
  REGISTRATION_CERTIFICATE
  NATIONAL_ID_CEO
  TAX_CLEARANCE
  SOCIAL_SECURITY_CLEARANCE
  ENVIRONMENTAL_PERMIT
  INDUSTRY_LICENSE
  FIRE_SAFETY_CERT
  FINANCIAL_STATEMENT
  BUSINESS_PLAN
  LEASE_CONTRACT
  OTHER
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS — M3: Guard Portal & Gate Control
// ═══════════════════════════════════════════════════════════════════════════════

enum VehicleType {
  TRUCK
  SEMI_TRUCK
  PICKUP
  VAN
  CAR
  MOTORCYCLE
  HEAVY_MACHINERY
  FORKLIFT
  BUS
  MINIBUS
  OTHER
}

enum VehicleStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum VehiclePermitType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  PERMANENT
  CONTRACTOR
  VISITOR
}

enum TrafficDirection {
  ENTRY
  EXIT
}

enum EntryMethod {
  ANPR_AUTO
  QR_SCAN
  RFID
  MANUAL
  OVERRIDE
  INTERCOM
}

enum AccessResult {
  ALLOWED
  DENIED_BLACKLIST
  DENIED_NO_PERMIT
  DENIED_EXPIRED_PERMIT
  DENIED_WRONG_GATE
  DENIED_WRONG_HOURS
  DENIED_HAZMAT
  DENIED_ZONE_CLOSED
  PENDING_GUARD_APPROVAL
  OVERRIDE_ALLOWED
}

enum IncidentType {
  UNAUTHORIZED_ENTRY
  SUSPICIOUS_VEHICLE
  BARRIER_FORCED
  OVERSTAY
  HAZMAT_VIOLATION
  FIGHT_ALTERCATION
  THEFT
  ACCIDENT
  MEDICAL_EMERGENCY
  FIRE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlacklistType {
  PLATE
  NATIONAL_ID
  PHONE
  DRIVER_NAME
}

enum BlacklistSeverity {
  WARNING
  DENY
  ALERT_SECURITY
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODELS — M1: Auth & User Management
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id                 String     @id @default(uuid())
  zoneId             String?
  companyId          String?
  email              String     @unique
  phone              String     @unique
  passwordHash       String
  firstName          String
  lastName           String
  nationalId         String?    @unique
  role               UserRole
  status             UserStatus @default(PENDING)
  avatarKey          String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean    @default(false)
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  zone           Zone?            @relation(fields: [zoneId], references: [id])
  company        Company?         @relation(fields: [companyId], references: [id])
  sessions       UserSession[]
  auditLogs      AuditLog[]
  permissions    UserPermission[]
  roleAssignments RoleAssignment[]
  hostedVisits   VisitorRequest[] @relation("VisitorHost")
  approvedVisits VisitorRequest[] @relation("VisitorApprover")
  digitalCertificates DigitalCertificate[]

  @@index([zoneId])
  @@index([companyId])
  @@index([role])
  @@index([status])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRevoked])
}

model UserPermission {
  id         String    @id @default(uuid())
  userId     String
  permission String
  grantedBy  String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, permission])
  @@index([userId])
}

model Role {
  id          String       @id @default(uuid())
  name        String
  nameFa      String
  description String?
  scopeType   RoleScope    @default(GLOBAL)
  zoneId      String?
  companyId   String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([name, zoneId, companyId])
  @@index([scopeType])
  @@index([zoneId])
  @@index([companyId])
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  permission String
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
}

model RoleAssignment {
  userId     String
  roleId     String
  assignedBy String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

model AuditLog {
  id         String   @id @default(uuid())
  zoneId     String?
  userId     String?
  targetId   String?
  targetType String?
  action     String
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String  @id @default(uuid())
  zoneId    String?
  companyId String?

  // Targeting
  recipientId      String?
  recipientRole    String?
  recipientGroupId String?

  // Content
  module        NotificationModule
  eventType     String
  priority      NotificationPriority @default(NORMAL)
  title         String
  titleFa       String
  body          String?
  bodyFa        String?
  imageUrl      String?
  actionUrl     String?
  actionLabel   String?
  actionLabelFa String?

  // Entity link
  entityType String?
  entityId   String?

  // Scheduling
  scheduledAt DateTime?
  expiresAt   DateTime?

  // Grouping
  groupKey   String?
  isGrouped  Boolean @default(false)
  groupCount Int?

  // Metadata
  metadata  Json     @default("{}")
  tags      String[]
  createdBy String?
  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]

  @@index([recipientId, createdAt])
  @@index([zoneId, createdAt])
  @@index([companyId, createdAt])
  @@index([module, eventType])
  @@index([scheduledAt])
  @@index([groupKey])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODELS — M2: Zone & Company Onboarding
// ═══════════════════════════════════════════════════════════════════════════════

model Zone {
  id                String     @id @default(uuid())
  code              String     @unique
  nameFa            String
  nameEn            String?
  province          String
  city              String
  address           String?
  postalCode        String?
  phone             String?
  email             String?
  website           String?
  logoKey           String?
  mapCenterLat      Decimal?   @db.Decimal(10, 8)
  mapCenterLng      Decimal?   @db.Decimal(11, 8)
  mapZoomLevel      Int        @default(15)
  totalAreaHectares Decimal?   @db.Decimal(10, 2)
  industrialAreaHa  Decimal?   @db.Decimal(10, 2)
  greenAreaHa       Decimal?   @db.Decimal(10, 2)
  status            ZoneStatus @default(ACTIVE)
  settings          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  companies           Company[]
  plots               Plot[]
  users               User[]
  auditLogs           AuditLog[]
  holidays            ZoneHoliday[]
  gates               Gate[]
  waybills            Waybill[]
  appointments        TruckAppointment[]
  docks               Dock[]
  weighScales         WeighScale[]
  carriers            Carrier[]
  visitorRequests     VisitorRequest[]
  groupVisits         GroupVisit[]
  recurringPermits    RecurringVisitorPermit[]
  visitorBlacklist    VisitorBlacklist[]
  permitRequests      PermitRequest[]
  issuedPermits       IssuedPermit[]
  permitTemplates     PermitTemplate[]
  permitInspections   PermitInspection[]
  letters             Letter[]
  letterTemplates     LetterTemplate[]
  physicalShelves     PhysicalArchiveShelf[]
  physicalRecords     PhysicalLetterRecord[]
  vehicles            Vehicle[]
  trafficLogs         TrafficLog[]
  guardShifts         GuardShift[]
  gateIncidents       GateIncident[]
  blacklistEntries    Blacklist[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  workflowGroups      WorkflowGroup[]
  workflowSlaConfigs  WorkflowSlaConfig[]
  workflowMetrics     WorkflowMetricSnapshot[]
  accountingVouchers  AccountingVoucher[]
  invoices            Invoice[]
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  leaseContracts      LeaseContract[]
  budgets             Budget[]
  financialPeriods    FinancialPeriod[]
  financeConfig       ZoneFinanceConfig?

  // M11: B2B Exchange
  rfqs            RFQ[]
  productCatalogs ProductCatalog[]

  // M12: Commercial
  proformas              Proforma[]
  commercialOrders       CommercialOrder[]
  commercialContracts    CommercialContract[]
  collectionCases        CollectionCase[]

  // M13: CMMS
  assets                 Asset[]
  maintenancePlans       MaintenancePlan[]
  workOrders             WorkOrder[]
  spareParts             SparePart[]
  technicians            Technician[]
  maintenanceContractors MaintenanceContractor[]

  // M14: HSE
  hseIncidents           HseIncident[]
  hseInspections         HseInspection[]
  riskAssessments        RiskAssessment[]
  hseTrainingPlans       HseTrainingPlan[]

  // M15: HR & Payroll
  departments            Department[]
  employees              Employee[]
  shiftPatterns          ShiftPattern[]

  // M17: Inventory & Warehouse
  warehouses             Warehouse[]
  itemCategories         ItemCategory[]
  items                  Item[]
  materialRequisitions   MaterialRequisition[]
  goodsReceipts          GoodsReceipt[]
  purchaseRequests       PurchaseRequest[]
  purchaseOrders         PurchaseOrder[]
  vendors                Vendor[]
  physicalCounts         PhysicalCount[]
  stockEntries           StockEntry[]
  stockTransactions      StockTransaction[]

  // M18: Digital Signature
  digitalCertificates    DigitalCertificate[]
  signatureRequests      SignatureRequest[]
  documentSignatures     DocumentSignature[]
  signatureTemplates     SignatureTemplate[]
  signatureAuditLogs     SignatureAuditLog[]

  // M19: Reporting & BI
  reportDefinitions       ReportDefinition[]
  reportSchedules         ReportSchedule[]
  reportExecutions        ReportExecution[]
  dashboards              Dashboard[]
  dailyMetricSnapshots    DailyMetricSnapshot[]
  kpiTargets              KpiTarget[]
  // M20: IoT
  iotDevices              IoTDevice[]
  geofenceZones           GeofenceZone[]
  // M21
  subscription            ZoneSubscription?
}

model ZoneHoliday {
  id        String      @id @default(uuid())
  zoneId    String
  date      String
  nameFa    String
  type      HolidayType
  createdAt DateTime    @default(now())

  zone Zone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, date])
}

model Gate {
  id         String   @id @default(uuid())
  zoneId     String
  code       String
  nameFa     String
  type       GateType
  location   String?
  lat        Decimal? @db.Decimal(10, 8)
  lng        Decimal? @db.Decimal(11, 8)
  isActive   Boolean  @default(true)
  hasAnpr    Boolean  @default(false)
  hasBarrier Boolean  @default(false)
  hasScale   Boolean  @default(false)
  deviceIds  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  zone        Zone         @relation(fields: [zoneId], references: [id])
  trafficLogs TrafficLog[]

  @@unique([zoneId, code])
  @@index([zoneId])
}

model Company {
  id                  String           @id @default(uuid())
  zoneId              String
  registrationNumber  String           @unique
  nationalId          String           @unique
  nameFa              String
  nameEn              String?
  type                CompanyType
  industryCategory    String
  industrySubCategory String?
  economicCode        String?
  phone               String?
  fax                 String?
  email               String?
  website             String?
  address             String?
  postalCode          String?
  ceoName             String
  ceoNationalId       String
  ceoPhone            String
  ceoEmail            String?
  establishedYear     Int?
  employeeCount       Int?
  annualCapacity      String?
  mainProduct         String?
  logoKey             String?
  lifecycleStatus     CompanyLifecycle @default(APPLICANT)
  isActive            Boolean          @default(false)
  creditLimit         BigInt           @default(0)
  creditUsed          BigInt           @default(0)
  riskLevel           RiskLevel        @default(LOW)
  healthScore         Int?
  plotId              String?          @unique
  tags                String[]
  notes               String?
  metadata            Json             @default("{}")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  zone               Zone                     @relation(fields: [zoneId], references: [id])
  plot               Plot?                    @relation(fields: [plotId], references: [id])
  users              User[]
  documents          CompanyDocument[]
  contacts           CompanyContact[]
  workflowSteps      OnboardingStep[]
  vehicles           Vehicle[]
  healthScoreHistory CompanyHealthScore[]
  waybills           Waybill[]
  appointments       TruckAppointment[]
  visitorRequests    VisitorRequest[]
  groupVisits        GroupVisit[]
  recurringPermits   RecurringVisitorPermit[]
  permitRequests     PermitRequest[]
  issuedPermits      IssuedPermit[]
  letters            Letter[]
  invoices           Invoice[]
  leaseContracts     LeaseContract[]

  // M11: B2B Exchange
  rfqs            RFQ[]
  productCatalogs ProductCatalog[]

  // M12: Commercial
  proformas              Proforma[]
  commercialOrders       CommercialOrder[]
  commercialContracts    CommercialContract[]
  collectionCases        CollectionCase[]

  // M15: HR & Payroll
  departments            Department[]
  positions              Position[]
  employees              Employee[]
  employeeContracts      EmployeeContract[]
  shiftPatterns          ShiftPattern[]
  payrolls               Payroll[]
  payslips               Payslip[]
  leaveRequests          LeaveRequest[]
  attendanceRecords      AttendanceRecord[]
  performanceReviews     PerformanceReview[]
  employeeLoans          EmployeeLoan[]

  // M17: Inventory & Warehouse
  warehouses             Warehouse[]
  items                  Item[]
  materialRequisitions   MaterialRequisition[]
  goodsReceipts          GoodsReceipt[]
  purchaseRequests       PurchaseRequest[]
  purchaseOrders         PurchaseOrder[]
  stockEntries           StockEntry[]
  stockTransactions      StockTransaction[]
  physicalCounts         PhysicalCount[]

  // M19: Reporting & BI
  reportDefinitions       ReportDefinition[]
  dailyMetricSnapshots    DailyMetricSnapshot[]
  dashboards              Dashboard[]

  @@index([zoneId, lifecycleStatus])
  @@index([zoneId, nameFa])
}

model Plot {
  id           String     @id @default(uuid())
  zoneId       String
  code         String
  block        String
  unitNumber   String
  areaSqM      Decimal    @db.Decimal(10, 2)
  type         PlotType
  status       PlotStatus @default(AVAILABLE)
  lat          Decimal?   @db.Decimal(10, 8)
  lng          Decimal?   @db.Decimal(11, 8)
  geoPolygon   Json?
  monthlyRent  BigInt?
  utilityMeter Json?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  zone    Zone     @relation(fields: [zoneId], references: [id])
  company Company?

  @@unique([zoneId, code])
  @@index([zoneId, status])
}

model CompanyDocument {
  id         String       @id @default(uuid())
  companyId  String
  type       DocumentType
  title      String
  fileKey    String
  fileSize   Int
  mimeType   String
  issuedAt   DateTime?
  expiresAt  DateTime?
  isVerified Boolean      @default(false)
  verifiedBy String?
  verifiedAt DateTime?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([expiresAt])
}

model CompanyContact {
  id        String   @id @default(uuid())
  companyId String
  name      String
  role      String
  phone     String
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model OnboardingStep {
  id          String             @id @default(uuid())
  companyId   String
  stepName    OnboardingStepName
  status      StepStatus         @default(PENDING)
  assignedTo  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  comment     String?
  attachments String[]
  startedAt   DateTime?
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, stepName])
  @@index([companyId])
}

model CompanyHealthScore {
  id               String   @id @default(uuid())
  companyId        String
  score            Int
  financialScore   Int
  hseScore         Int
  operationalScore Int
  complianceScore  Int
  computedAt       DateTime @default(now())
  factors          Json

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, computedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODELS — M3: Guard Portal & Gate Control
// ═══════════════════════════════════════════════════════════════════════════════

model Vehicle {
  id               String            @id @default(uuid())
  zoneId           String
  companyId        String?
  plate            String
  plateNormalized  String
  type             VehicleType
  brand            String?
  model            String?
  color            String?
  year             Int?
  ownerName        String?
  ownerPhone       String?
  driverName       String?
  driverPhone      String?
  driverNationalId String?
  status           VehicleStatus     @default(ACTIVE)
  isBlacklisted    Boolean           @default(false)
  blacklistReason  String?
  blacklistedAt    DateTime?
  blacklistedBy    String?
  permitType       VehiclePermitType @default(NONE)
  permitExpiresAt  DateTime?
  tags             String[]
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  zone          Zone                  @relation(fields: [zoneId], references: [id])
  company       Company?              @relation(fields: [companyId], references: [id])
  trafficLogs   TrafficLog[]
  accessPermits VehicleAccessPermit[]

  @@unique([zoneId, plateNormalized])
  @@index([zoneId, plate])
  @@index([zoneId, isBlacklisted])
  @@index([zoneId, status])
  @@index([companyId])
}

model VehicleAccessPermit {
  id           String            @id @default(uuid())
  zoneId       String
  vehicleId    String
  companyId    String?
  type         VehiclePermitType
  allowedGates String[]
  allowedHours Json?
  validFrom    DateTime
  validUntil   DateTime?
  isActive     Boolean           @default(true)
  issuedBy     String
  revokedBy    String?
  revokedAt    DateTime?
  revokeReason String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, isActive])
  @@index([zoneId, type])
}

model TrafficLog {
  id              String           @id @default(uuid())
  zoneId          String
  gateId          String
  vehicleId       String?
  plate           String
  plateConfidence Float?
  direction       TrafficDirection
  vehicleType     VehicleType?
  companyId       String?
  companyName     String?
  driverName      String?
  waybillId       String?
  visitorId       String?
  purpose         String?
  entryMethod     EntryMethod
  accessResult    AccessResult
  denyReason      String?
  barrierOpened   Boolean          @default(false)
  barrierOpenedAt DateTime?
  manualOverride  Boolean          @default(false)
  overrideBy      String?
  overrideReason  String?
  imageKey        String?
  weight          Decimal?         @db.Decimal(10, 3)
  guardId         String
  processedAt     DateTime         @default(now())
  exitAt          DateTime?
  dwellMinutes    Int?
  notes           String?
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now())

  zone    Zone     @relation(fields: [zoneId], references: [id])
  gate    Gate     @relation(fields: [gateId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([zoneId, processedAt])
  @@index([zoneId, plate])
  @@index([zoneId, direction, processedAt])
  @@index([gateId, processedAt])
  @@index([companyId, processedAt])
  @@index([vehicleId])
}

model GuardShift {
  id            String    @id @default(uuid())
  zoneId        String
  gateId        String
  guardId       String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  handoverTo    String?
  handoverNotes String?
  summary       Json?
  createdAt     DateTime  @default(now())

  zone Zone @relation(fields: [zoneId], references: [id])

  @@index([zoneId, guardId])
  @@index([gateId, startedAt])
}

model GateIncident {
  id           String           @id @default(uuid())
  zoneId       String
  gateId       String
  guardId      String
  shiftId      String?
  trafficLogId String?
  type         IncidentType
  severity     IncidentSeverity
  description  String
  plate        String?
  personName   String?
  imageKeys    String[]
  videoKey     String?
  resolvedAt   DateTime?
