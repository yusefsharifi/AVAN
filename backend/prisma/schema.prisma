  company  Company?         @relation(fields: [companyId], references: [id])
  lines    InvoiceLine[]
  payments InvoicePayment[]

  @@index([zoneId, status])
  @@index([companyId, status])
  @@index([zoneId, dueDate])
  @@index([partyId, status])
  @@index([sourceModule, sourceEntityId])
}

model InvoiceLine {
