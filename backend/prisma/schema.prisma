// M15: HR & Payroll Models
// ═══════════════════════════════════════════════════════════════════════════════

model Department {
  id              String        @id @default(uuid())
  zoneId          String
  companyId       String
  code            String
  nameFa          String
  nameEn          String?
  parentId        String?
  managerId       String?
  costCenterId    String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parent          Department?   @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[]  @relation("DeptHierarchy")
  positions       Position[]
  employees       Employee[]

  zone            Zone          @relation(fields: [zoneId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Position {
  id              String      @id @default(uuid())
  zoneId          String
  companyId       String
  departmentId    String
  code            String
  titleFa         String
  titleEn         String?
  level           Int         @default(1)
  grade           Int?
  minSalary       BigInt?
  maxSalary       BigInt?
  isActive        Boolean     @default(true)
  headcount       Int         @default(1)
  currentCount    Int         @default(0)

  department      Department  @relation(fields: [departmentId], references: [id])
  company         Company     @relation(fields: [companyId], references: [id])
  employees       Employee[]

  @@unique([companyId, code])
  @@index([departmentId])
}

model Employee {
  id                    String              @id @default(uuid())
  zoneId                String
  companyId             String
  userId                String?             @unique
  employeeNumber        String              @unique

  firstNameFa           String
  lastNameFa            String
  firstNameEn           String?
  lastNameEn            String?
  nationalId            String              @unique
  dateOfBirth           String
  gender                Gender
  maritalStatus         MaritalStatus       @default(SINGLE)
  nationalityCode       String              @default("IR")
  militaryStatus        MilitaryStatus?

  phone                 String
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRel   String?

  departmentId          String
  positionId            String
  reportingManagerId    String?
  employmentType        EmploymentType      @default(FULL_TIME)
  status                EmploymentStatus    @default(ACTIVE)
  hireDate              String
  contractStartDate     String?
  contractEndDate       String?
  probationEndDate      String?
  terminationDate       String?
  terminationReason     String?

  baseSalary            BigInt
  housingAllowance      BigInt              @default(0)
  transportAllowance    BigInt              @default(0)
  foodAllowance         BigInt              @default(0)
  overtimeRate          Decimal?            @db.Decimal(5,2)

  socialSecurityNumber  String?
  insurancePercentEmployee Decimal          @db.Decimal(5,2) @default(7)
  insurancePercentEmployer Decimal          @db.Decimal(5,2) @default(23)

  bankName              String?
  bankAccountNumber     String?
  bankShebaNumber       String?

  photoKey              String?
  documentKeys          String[]

  annualLeaveBalance    Decimal             @db.Decimal(5,1) @default(26)
  sickLeaveBalance      Decimal             @db.Decimal(5,1) @default(10)
  personalLeaveBalance  Decimal             @db.Decimal(5,1) @default(3)

  rfidCardNumber        String?             @unique

  department            Department          @relation(fields: [departmentId], references: [id])
  position              Position            @relation(fields: [positionId], references: [id])
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  payslips              Payslip[]
  evaluations           PerformanceReview[]
  loans                 EmployeeLoan[]
  contracts             EmployeeContract[]

  notes                 String?
  metadata              Json                @default("{}")
  createdBy             String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  zone                  Zone                @relation(fields: [zoneId], references: [id])
  company               Company             @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([departmentId, status])
  @@index([nationalId])
  @@index([rfidCardNumber])
  @@index([zoneId, status])
}

model EmployeeContract {
  id              String          @id @default(uuid())
  employeeId      String
  companyId       String
  contractNumber  String          @unique
  type            ContractType
  startDate       String
  endDate         String?
  isCurrent       Boolean         @default(true)
  baseSalary      BigInt
  fileKey         String?
  signedAt        DateTime?
  notes           String?
  createdAt       DateTime        @default(now())

  employee        Employee        @relation(fields: [employeeId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])

  @@index([employeeId])
}

model ShiftPattern {
  id              String    @id @default(uuid())
  zoneId          String
  companyId       String
  name            String
  workDays        Int[]
  startTime       String
  endTime         String
  breakMinutes    Int       @default(60)
  isNightShift    Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  zone            Zone      @relation(fields: [zoneId], references: [id])
  company         Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model AttendanceRecord {
  id              String              @id @default(uuid())
  zoneId          String
  companyId       String
  employeeId      String
  workDate        String
  shiftId         String?

  clockIn         DateTime?
  clockOut        DateTime?
  clockInMethod   AttendanceMethod?
  clockOutMethod  AttendanceMethod?
  clockInGateId   String?
  clockOutGateId  String?

  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  workedMinutes   Int                 @default(0)
  breakMinutes    Int                 @default(0)
  regularMinutes  Int                 @default(0)
  overtimeMinutes Int                 @default(0)
  lateMinutes     Int                 @default(0)
  earlyLeaveMin   Int                 @default(0)

  status          AttendanceStatus    @default(PRESENT)
  isManualOverride Boolean            @default(false)
  overrideReason  String?
  overrideBy      String?

  isApproved      Boolean             @default(false)
  approvedBy      String?

