model IoTDevice {
  id                String              @id @default(uuid())
  zoneId            String
  deviceId          String              @unique
  name              String
  type              DeviceType
  protocol          DeviceProtocol
  status            DeviceStatus        @default(OFFLINE)
  isActive          Boolean             @default(true)

  // Physical location
  location          String?
  gateId            String?
  lat               Decimal?            @db.Decimal(10,8)
  lng               Decimal?            @db.Decimal(11,8)

  // Network config
  ipAddress         String?
  port              Int?
  macAddress        String?
  mqttClientId      String?             @unique
  mqttTopic         String?

  // Authentication
  username          String?
  passwordHash      String?
  apiKey            String?
  certificateKey    String?

  // Device info
  manufacturer      String?
  model             String?
  firmwareVersion   String?
  serialNumber      String?
  installDate       DateTime?
  warrantyExpiry    DateTime?

  // Health monitoring
  lastSeenAt        DateTime?
  lastHeartbeatAt   DateTime?
  heartbeatInterval Int                 @default(30)
  isOnline          Boolean             @default(false)
  signalStrength    Int?
  batteryLevel      Int?
  uptimeSeconds     Int?
  errorCount        Int                 @default(0)
  lastError         String?
  lastErrorAt       DateTime?

  // Calibration
  lastCalibratedAt  DateTime?
  calibrationDue    DateTime?

  // Configuration
  config            Json                @default("{}")

  // Statistics
  totalEvents       Int                 @default(0)
  totalErrors       Int                 @default(0)
  avgResponseMs     Decimal?            @db.Decimal(8,2)

  notes             String?
  metadata          Json                @default("{}")
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  zone              Zone                @relation(fields: [zoneId], references: [id])
  readings          DeviceReading[]
  commands          DeviceCommand[]
  alerts            DeviceAlert[]
  healthLogs        DeviceHealthLog[]

  @@index([zoneId, type, status])
  @@index([zoneId, isOnline])
  @@index([gateId])
  @@index([mqttClientId])
}

model DeviceReading {
  id              String          @id @default(uuid())
  deviceId        String
  zoneId          String
  type            ReadingType
  payload         Json
  processedAt     DateTime        @default(now())
  isProcessed     Boolean         @default(false)
  processingResult Json?
  processingError String?
  linkedEntityId  String?
  linkedEntityType String?
  createdAt       DateTime        @default(now())

  device          IoTDevice       @relation(fields: [deviceId], references: [id])

  @@index([deviceId, processedAt])
  @@index([zoneId, type, processedAt])
  @@index([isProcessed])
  @@index([createdAt])
}

model DeviceCommand {
  id              String          @id @default(uuid())
  deviceId        String
  zoneId          String
  type            CommandType
  payload         Json
  status          CommandStatus   @default(QUEUED)
  issuedBy        String
  issuedAt        DateTime        @default(now())
  sentAt          DateTime?
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  errorMessage    String?
  timeoutSeconds  Int             @default(10)
  retryCount      Int             @default(0)
  maxRetries      Int             @default(3)
  response        Json?
  correlationId   String?
  priority        Int             @default(5)

  device          IoTDevice       @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@index([status, issuedAt])
  @@index([correlationId])
}

model DeviceAlert {
  id              String          @id @default(uuid())
  deviceId        String
  zoneId          String
  alertType       DeviceAlertType
  severity        AlertSeverity
  message         String
  details         Json            @default("{}")
  isResolved      Boolean         @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  notificationSent Boolean        @default(false)
  createdAt       DateTime        @default(now())

  device          IoTDevice       @relation(fields: [deviceId], references: [id])

  @@index([deviceId, isResolved])
  @@index([zoneId, severity, isResolved])
  @@index([createdAt])
}

model DeviceHealthLog {
  id              String    @id @default(uuid())
  deviceId        String
  zoneId          String
  isOnline        Boolean
  signalStrength  Int?
  batteryLevel    Int?
  uptimeSeconds   Int?
  cpuPercent      Int?
  memoryPercent   Int?
  diskPercent     Int?
  temperature     Decimal?  @db.Decimal(5,2)
  errorCount      Int       @default(0)
  responseMs      Int?
  recordedAt      DateTime  @default(now())

  device          IoTDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, recordedAt])
  @@index([zoneId, recordedAt])
}

model GeofenceZone {
  id              String    @id @default(uuid())
  zoneId          String
  name            String
  type            String
  polygon         Json
  radius          Decimal?  @db.Decimal(10,2)
  centerLat       Decimal?  @db.Decimal(10,8)
  centerLng       Decimal?  @db.Decimal(11,8)
  isActive        Boolean   @default(true)
  notifyOnEntry   Boolean   @default(true)
  notifyOnExit    Boolean   @default(true)
  allowedVehicles String[]
  createdAt       DateTime  @default(now())

  zone            Zone      @relation(fields: [zoneId], references: [id])

  @@index([zoneId, isActive])
}

model VehicleTrackingPoint {
  id          String    @id @default(uuid())
  zoneId      String
  vehicleId   String?
  deviceId    String
  plate       String?
  lat         Decimal   @db.Decimal(10,8)
  lng         Decimal   @db.Decimal(11,8)
  speed       Decimal   @db.Decimal(5,2)
  heading     Int?
  altitude    Decimal?  @db.Decimal(8,2)
  accuracy    Decimal?  @db.Decimal(6,2)
  satellites  Int?
  isMoving    Boolean   @default(false)
  recordedAt  DateTime

  @@index([deviceId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([zoneId, recordedAt])
}

