// ═══════════════════════════════════════════════════════════════════════════════
// M17: Inventory & Warehouse Models
// ═══════════════════════════════════════════════════════════════════════════════

model Warehouse {
  id              String          @id @default(uuid())
  zoneId          String
  companyId       String?
  code            String
  nameFa          String
  nameEn          String?
  type            WarehouseType
  address         String?
  managerId       String?
  isActive        Boolean         @default(true)
  isDefault       Boolean         @default(false)
  totalCapacity   Decimal?        @db.Decimal(10,2)
  capacityUnit    String?
  temperatureMin  Decimal?        @db.Decimal(5,2)
  temperatureMax  Decimal?        @db.Decimal(5,2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  locations       WarehouseLocation[]
  stockEntries    StockEntry[]
  transactions    StockTransaction[]

  company         Company?        @relation(fields: [companyId], references: [id])
  @@unique([zoneId, code])
  @@index([zoneId, isActive])
  @@index([companyId])
}

model WarehouseLocation {
  id              String    @id @default(uuid())
  warehouseId     String
  code            String
  aisle           String?
  rack            String?
  bin             String?
  level           Int?
  type            String    @default("STORAGE")
  capacity        Decimal?  @db.Decimal(10,3)
  capacityUnit    String?
  isActive        Boolean   @default(true)

  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  stockEntries    StockEntry[]

  @@unique([warehouseId, code])
  @@index([warehouseId, isActive])
}

model ItemCategory {
  id          String        @id @default(uuid())
  zoneId      String?
  code        String
  nameFa      String
  nameEn      String?
  parentId    String?
  level       Int           @default(1)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())

  parent      ItemCategory? @relation("ItemCategoryParent", fields: [parentId], references: [id])
  children    ItemCategory[] @relation("ItemCategoryParent")
  items       Item[]

  @@unique([zoneId, code])
  @@index([parentId])
  zone            Zone?           @relation(fields: [zoneId], references: [id])
}

model Item {
  id                String          @id @default(uuid())
  zoneId            String
  companyId         String?
  itemCode          String          @unique
  nameFa            String
  nameEn            String?
  categoryId        String
  type              ItemType
  unit              String
  altUnit           String?
  altUnitConversion Decimal?        @db.Decimal(10,5)

  brand             String?
  model             String?
  specifications    Json?
  imageKeys         String[]
  barcode           String?         @unique
  qrCode            String?

  minStock          Decimal         @db.Decimal(15,3) @default(0)
  maxStock          Decimal?        @db.Decimal(15,3)
  reorderPoint      Decimal         @db.Decimal(15,3) @default(0)
  reorderQty        Decimal         @db.Decimal(15,3) @default(0)
  leadTimeDays      Int             @default(7)
  safetyStock       Decimal?        @db.Decimal(15,3)

  trackByBatch      Boolean         @default(false)
  trackBySerial     Boolean         @default(false)
  hasExpiry         Boolean         @default(false)
  expiryWarningDays Int             @default(30)

  valuationMethod   ValuationMethod @default(WEIGHTED_AVG)
  lastCost          BigInt          @default(0)
  avgCost           BigInt          @default(0)
  standardCost      BigInt?

  taxRate           Decimal         @db.Decimal(5,2) @default(9)
  isService         Boolean         @default(false)

  isActive          Boolean         @default(true)
  isStorable        Boolean         @default(true)
  isPurchasable     Boolean         @default(true)
  isSalable         Boolean         @default(true)

  notes             String?
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  category          ItemCategory    @relation(fields: [categoryId], references: [id])
  stockEntries      StockEntry[]
  transactions      StockTransaction[]
  requisitionLines  RequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseRequestLines PurchaseRequestLine[]
  countLines        PhysicalCountLine[]

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, categoryId, isActive])
  @@index([companyId, isActive])
  @@index([nameFa])
  @@index([barcode])
}

model StockEntry {
  id              String            @id @default(uuid())
  zoneId          String
  companyId       String?
  warehouseId     String
  locationId      String?
  itemId          String

  quantity        Decimal           @db.Decimal(15,3)
  reservedQty     Decimal           @db.Decimal(15,3) @default(0)
  availableQty    Decimal           @db.Decimal(15,3)

  batchNumber     String?
  lotNumber       String?
  serialNumber    String?
  expiryDate      DateTime?
  productionDate  DateTime?

  unitCost        BigInt
  totalValue      BigInt

  isOnHold        Boolean           @default(false)
  holdReason      String?
  condition       String            @default("GOOD")

  lastMovementAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  item            Item              @relation(fields: [itemId], references: [id])

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@unique([warehouseId, itemId, batchNumber, serialNumber])
  @@index([warehouseId, itemId])
  @@index([itemId, expiryDate])
  @@index([zoneId, companyId])
}

model StockTransaction {
  id                String              @id @default(uuid())
  zoneId            String
  companyId         String?
  transactionNumber String              @unique

  type              StockTransactionType
  status            TransactionStatus   @default(DRAFT)
  warehouseId       String
  itemId            String
  quantity          Decimal             @db.Decimal(15,3)
  unitCost          BigInt?
  totalCost         BigInt?
  direction         String

  sourceDocType     String?
  sourceDocId       String?
  batchNumber       String?
  serialNumber      String?
  fromLocationId    String?
  toLocationId      String?
  fromWarehouseId   String?
  toWarehouseId     String?

  voucherId         String?
  accountCodeId     String?

  notes             String?
  processedBy       String
  processedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())

  warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  item              Item                @relation(fields: [itemId], references: [id])

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, type])
  @@index([warehouseId, processedAt])
  @@index([itemId, processedAt])
  @@index([sourceDocType, sourceDocId])
}

model MaterialRequisition {
  id                String              @id @default(uuid())
  zoneId            String
  companyId         String
  requisitionNumber String              @unique

  requestedBy       String
  requestedByName   String
  departmentId      String?
  departmentName    String?
  purpose           String
  requiredDate      String
  status            RequisitionStatus   @default(DRAFT)
  priority          RequisitionPriority @default(NORMAL)

  lines             RequisitionLine[]

  approverId        String?
  approverName      String?
  approvedAt        DateTime?
  rejectionReason   String?

  isFullyFulfilled  Boolean             @default(false)
  fulfilledAt       DateTime?
  fulfilledBy       String?

  dispatchWarehouseId String?
  dispatchedAt      DateTime?
  dispatchedBy      String?
  receivedBy        String?
  receivedAt        DateTime?

  correspondenceLetterId String?
  workflowInstanceId String?

  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, status])
  @@index([companyId, status])
  @@index([requestedBy, status])
  @@index([approverId, status])
}

model RequisitionLine {
  id              String              @id @default(uuid())
  requisitionId   String
  itemId          String
  itemName        String
  itemCode        String
  unit            String
  requestedQty    Decimal             @db.Decimal(15,3)
  approvedQty     Decimal?            @db.Decimal(15,3)
  issuedQty       Decimal             @db.Decimal(15,3) @default(0)
  pendingQty      Decimal             @db.Decimal(15,3)
  unitCost        BigInt?
  totalCost       BigInt?
  warehouseId     String?
  locationId      String?
  batchNumber     String?
  notes           String?

  item            Item                @relation(fields: [itemId], references: [id])
  requisition     MaterialRequisition @relation(fields: [requisitionId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
}

model GoodsReceipt {
  id                String              @id @default(uuid())
  zoneId            String
  companyId         String?
  receiptNumber     String              @unique

  warehouseId       String
  purchaseOrderId   String?
  vendorId          String?
  vendorName        String
  vendorInvoiceNumber String?
  deliveryNote      String?

  receivedDate      String
  status            GRNStatus           @default(DRAFT)

  lines             GoodsReceiptLine[]

  requiresInspection Boolean           @default(false)
  inspectionStatus  String?
  inspectedBy       String?
  inspectedAt       DateTime?

  totalValue        BigInt
  voucherId         String?
  invoiceId         String?

  notes             String?
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, status])
  @@index([purchaseOrderId])
  @@index([warehouseId, receivedDate])
}

model GoodsReceiptLine {
  id                String    @id @default(uuid())
  receiptId         String
  purchaseOrderLineId String?
  itemId            String
  itemName          String
  unit              String
  orderedQty        Decimal?  @db.Decimal(15,3)
  receivedQty       Decimal   @db.Decimal(15,3)
  acceptedQty       Decimal   @db.Decimal(15,3)
  rejectedQty       Decimal   @db.Decimal(15,3) @default(0)
  unitCost          BigInt
  totalCost         BigInt
  locationId        String?
  batchNumber       String?
  serialNumbers     String[]
  expiryDate        DateTime?
  condition         String    @default("GOOD")
  rejectionReason   String?
  notes             String?

  receipt           GoodsReceipt @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@index([itemId])
}

model PurchaseRequest {
  id                String              @id @default(uuid())
  zoneId            String
  companyId         String
  requestNumber     String              @unique

  requestedBy       String
  requestedByName   String
  departmentId      String?
  purpose           String
  requiredDate      String
  status            PRStatus            @default(DRAFT)
  priority          RequisitionPriority @default(NORMAL)

  lines             PurchaseRequestLine[]

  approverId        String?
  approvedAt        DateTime?
  rejectionReason   String?

  workflowInstanceId String?
  totalEstimated    BigInt?

  purchaseOrderId   String?

  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, status])
  @@index([companyId, status])
}

model PurchaseRequestLine {
  id              String    @id @default(uuid())
  purchaseRequestId String
  itemId          String?
  itemName        String
  itemCode        String?
  unit            String
  requestedQty    Decimal   @db.Decimal(15,3)
  unitPrice       BigInt?
  totalEstimate   BigInt?
  vendorSuggested String?
  specifications  String?
  notes           String?

  item            Item?     @relation(fields: [itemId], references: [id])
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  @@index([purchaseRequestId])
}

model PurchaseOrder {
  id              String          @id @default(uuid())
  zoneId          String
  companyId       String?
  orderNumber     String          @unique

  vendorId        String?
  vendorName      String
  vendorPhone     String?
  vendorEmail     String?

  orderDate       String
  expectedDate    String?
  status          POStatus        @default(DRAFT)
  paymentTerms    String?
  deliveryAddress String?
  warehouseId     String?

  lines           PurchaseOrderLine[]

  subtotal        BigInt
  totalTax        BigInt
  totalDiscount   BigInt          @default(0)
  grandTotal      BigInt
  paidAmount      BigInt          @default(0)

  purchaseRequestId String?
  correspondenceLetterId String?
  voucherId       String?

  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, status])
  @@index([vendorId, status])
}

model PurchaseOrderLine {
  id              String    @id @default(uuid())
  purchaseOrderId String
  itemId          String?
  itemName        String
  unit            String
  orderedQty      Decimal   @db.Decimal(15,3)
  receivedQty     Decimal   @db.Decimal(15,3) @default(0)
  pendingQty      Decimal   @db.Decimal(15,3)
  unitPrice       BigInt
  discount        Decimal   @db.Decimal(5,2) @default(0)
  taxRate         Decimal   @db.Decimal(5,2) @default(9)
  lineTotal       BigInt
  dueDate         String?
  notes           String?

  item            Item?     @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model Vendor {
  id              String    @id @default(uuid())
  zoneId          String
  code            String
  nameFa          String
  nameEn          String?
  nationalId      String?
  taxId           String?
  phone           String?
  email           String?
  address         String?
  paymentTerms    String?
  rating          Decimal?  @db.Decimal(3,2)
  isActive        Boolean   @default(true)
  isBlacklisted   Boolean   @default(false)
  blacklistReason String?
  totalOrders     Int       @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  @@unique([zoneId, code])
  @@index([zoneId, isActive])
}

model PhysicalCount {
  id              String              @id @default(uuid())
  zoneId          String
  companyId       String?
  countNumber     String              @unique

  warehouseId     String
  status          CountStatus         @default(PLANNING)
  plannedDate     String
  startedAt       DateTime?
  completedAt     DateTime?

  lines           PhysicalCountLine[]

  totalVarianceValue BigInt          @default(0)
  adjustmentVoucherId String?
  notes           String?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  zone            Zone            @relation(fields: [zoneId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])
  @@index([zoneId, status])
  @@index([warehouseId, plannedDate])
}

model PhysicalCountLine {
  id              String    @id @default(uuid())
  countId         String
  itemId          String
  itemName        String
  itemCode        String
  unit            String
  systemQty       Decimal   @db.Decimal(15,3)
  countedQty      Decimal?  @db.Decimal(15,3)
  variance        Decimal?  @db.Decimal(15,3)
  varianceValue   BigInt?
  batchNumber     String?
  locationId      String?
  countedBy       String?
  countedAt       DateTime?
  notes           String?

  count           PhysicalCount @relation(fields: [countId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])

  @@index([countId])
  @@index([itemId])
}

