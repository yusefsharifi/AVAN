  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee        Employee        @relation(fields: [employeeId], references: [id])
  company         Company?        @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@index([approverId, status])
}

model Payroll {
  id              String          @id @default(uuid())
  zoneId          String
  companyId       String
  periodMonth     Int
  periodYear      Int
  status          PayrollStatus   @default(DRAFT)
  runAt           DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  paidAt          DateTime?
  totalGross      BigInt          @default(0)
  totalNet        BigInt          @default(0)
  totalTax        BigInt          @default(0)
  totalInsurance  BigInt          @default(0)
  totalDeductions BigInt          @default(0)
  totalAllowances BigInt          @default(0)
  employeeCount   Int             @default(0)
  voucherId       String?

  payslips        Payslip[]

  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company         Company?        @relation(fields: [companyId], references: [id])

  @@unique([companyId, periodYear, periodMonth])
  @@index([zoneId, status])
  @@index([companyId, periodYear])
}

model Payslip {
  id                    String      @id @default(uuid())
  payrollId             String
  employeeId            String
  companyId             String
  zoneId                String
  periodMonth           Int
  periodYear            Int

  workDays              Int
  presentDays           Int
  absentDays            Int
  leaveDays             Decimal     @db.Decimal(5,1)
  overtimeHours         Decimal     @db.Decimal(6,2)

  baseSalary            BigInt
  housingAllowance      BigInt
  transportAllowance    BigInt
  foodAllowance         BigInt
  overtimePay           BigInt      @default(0)
  bonusAmount           BigInt      @default(0)
  otherEarnings         BigInt      @default(0)
  grossSalary           BigInt

  incomeTax             BigInt      @default(0)
  socialSecurityEmployee BigInt     @default(0)
  loanDeduction         BigInt      @default(0)
  absenceDeduction      BigInt      @default(0)
  otherDeductions       BigInt      @default(0)
  totalDeductions       BigInt

  netSalary             BigInt

  socialSecurityEmployer BigInt     @default(0)

  status                PayslipStatus @default(DRAFT)
  pdfKey                String?

  employee              Employee    @relation(fields: [employeeId], references: [id])
  payroll               Payroll     @relation(fields: [payrollId], references: [id])
  company               Company     @relation(fields: [companyId], references: [id])

  @@unique([payrollId, employeeId])
  @@index([employeeId, periodYear, periodMonth])
  @@index([companyId, periodYear])
}

model PerformanceReview {
  id                String              @id @default(uuid())
  zoneId            String
  companyId         String
  employeeId        String
  reviewerId        String
  reviewerName      String
  period            String
  type              ReviewType
  status            ReviewStatus        @default(DRAFT)

  qualityScore      Decimal?            @db.Decimal(3,2)
  attendanceScore   Decimal?            @db.Decimal(3,2)
  initiativeScore   Decimal?            @db.Decimal(3,2)
  teamworkScore     Decimal?            @db.Decimal(3,2)
  communicationScore Decimal?           @db.Decimal(3,2)
  technicalScore    Decimal?            @db.Decimal(3,2)
  overallScore      Decimal?            @db.Decimal(3,2)
  overallRating     PerformanceRating?

  strengths         String?             @db.Text
  areasForImprovement String?           @db.Text
  goals             String?             @db.Text
  developmentPlan   String?             @db.Text

