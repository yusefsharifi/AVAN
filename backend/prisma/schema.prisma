// ═══════════════════════════════════════════════════════════════════════════════
// M18: Digital Signature Models
// ═══════════════════════════════════════════════════════════════════════════════

model DigitalCertificate {
  id                String              @id @default(uuid())
  zoneId            String?
  userId            String
  type              CertificateType
  status            CertificateStatus   @default(PENDING_VERIFICATION)

  commonName        String
  organizationName  String?
  organizationalUnit String?
  countryCode       String              @default("IR")
  serialNumber      String              @unique

  issuedAt          DateTime
  expiresAt         DateTime
  issuerName        String
  issuerDN          String

  publicKeyPem      String              @db.Text
  subjectDN         String
  keyAlgorithm      String              @default("RSA")
  keySize           Int                 @default(2048)
  signatureAlgorithm String            @default("SHA256withRSA")

  storageType       CertStorageType
  certFileKey       String?
  tokenSerial       String?

  sha1Fingerprint   String?
  sha256Fingerprint String?

  encryptedPfxKey   String?
  pfxPasswordHash   String?

  isVerified        Boolean             @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  verificationMethod String?

  revokedAt         DateTime?
  revokedBy         String?
  revocationReason  String?
  crlDistributionPoint String?
  ocspUrl           String?

  metadata          Json                @default("{}")
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  signatures        DocumentSignature[]

  user              User                @relation(fields: [userId], references: [id])
  zone              Zone?               @relation(fields: [zoneId], references: [id])

  @@index([userId, status])
  @@index([serialNumber])
  @@index([expiresAt, status])
}

model SignatureRequest {
  id                String              @id @default(uuid())
  zoneId            String
  documentType      SignableDocumentType
  documentId        String
  documentTitle     String
  documentHash      String

  status            SignatureRequestStatus @default(PENDING)
  signingMode       SigningMode          @default(SEQUENTIAL)

  signers           SignatureRequestSigner[]
  signatures        DocumentSignature[]

  deadline          DateTime?
  createdBy         String
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  documentSnapshotKey String?
  metadata          Json                @default("{}")

  zone            Zone            @relation(fields: [zoneId], references: [id])
  @@index([documentType, documentId])
  @@index([zoneId, status])
  @@index([createdAt])
}

model SignatureRequestSigner {
  id                String              @id @default(uuid())
  signatureRequestId String
  signerOrder       Int
  signerId          String
  signerName        String
  signerRole        String
  status            SignerStatus        @default(PENDING)
  isRequired        Boolean             @default(true)
  notifiedAt        DateTime?
  reminderCount     Int                 @default(0)
  lastReminderAt    DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  declineReason     String?
  certificateId     String?

  request           SignatureRequest    @relation(fields: [signatureRequestId], references: [id])

  @@unique([signatureRequestId, signerOrder])
  @@index([signerId, status])
}

model DocumentSignature {
  id                String              @id @default(uuid())
  zoneId            String
  signatureRequestId String?
  documentType      SignableDocumentType
  documentId        String
  documentTitle     String

  signerId          String
  signerName        String
  signerRole        String?
  certificateId     String?

  signatureType     SignatureType
  signatureValue    String              @db.Text
  documentHash      String
  signedAt          DateTime            @default(now())
  signedByIp        String?
  signedByDevice    String?

  timestampToken    String?             @db.Text
  timestampAt       DateTime?
  tsaName           String?

  isVerified        Boolean             @default(false)
  verifiedAt        DateTime?
  verificationResult Json?

  signaturePage     Int?
  signatureX        Decimal?            @db.Decimal(8,2)
  signatureY        Decimal?            @db.Decimal(8,2)
  signatureWidth    Decimal?            @db.Decimal(8,2)
  signatureHeight   Decimal?            @db.Decimal(8,2)

  verificationQrHash String?            @unique
  signatureOrder    Int                 @default(1)
  previousSignatureId String?

  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())

  certificate       DigitalCertificate? @relation(fields: [certificateId], references: [id])
  request           SignatureRequest?   @relation(fields: [signatureRequestId], references: [id])

  zone            Zone            @relation(fields: [zoneId], references: [id])
  @@index([documentType, documentId])
  @@index([signerId, signedAt])
  @@index([verificationQrHash])
  @@index([zoneId, signedAt])
}

model SignatureTemplate {
  id              String                @id @default(uuid())
  zoneId          String?
  documentType    SignableDocumentType
  nameFa          String
  signers         Json
  signingMode     SigningMode
  deadlineDays    Int                   @default(3)
  isActive        Boolean               @default(true)
  createdBy       String
  createdAt       DateTime              @default(now())

  zone            Zone?           @relation(fields: [zoneId], references: [id])
  @@index([documentType, isActive])
}

model SignatureAuditLog {
