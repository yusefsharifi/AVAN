  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId, transactionDate])
  @@index([zoneId, transactionDate])
  @@index([isReconciled])
}

model LeaseContract {
  id                String      @id @default(uuid())
  zoneId            String
  companyId         String
  contractNumber    String      @unique
  plotId            String?
  block             String?
  unit              String?
  areaSqM           Decimal?    @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime
  autoRenew         Boolean     @default(false)
  renewalNoticeDays Int         @default(60)
  status            LeaseStatus @default(ACTIVE)
