model LeasePayment {
  id            String        @id @default(uuid())
  contractId    String
  dueDate       DateTime
  amount        BigInt
  invoiceId     String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  paidAmount    BigInt?
  penaltyAmount BigInt        @default(0)
  notes         String?
  createdAt     DateTime      @default(now())

  contract LeaseContract @relation(fields: [contractId], references: [id])

  @@index([contractId, dueDate])
  @@index([status, dueDate])
}

model Budget {
  id          String       @id @default(uuid())
  zoneId      String
  name        String
